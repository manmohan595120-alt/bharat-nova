<script>
(() => {
  "use strict";

  const KEY = "bharatNovaChatHistoryV1";
  const panel = document.getElementById("novaChatPanel");
  if (!panel || document.getElementById("novaHistoryPanel")) return;

  const historyPanel = document.createElement("section");
  historyPanel.id = "novaHistoryPanel";
  historyPanel.className = "nova-history-panel";
  historyPanel.hidden = true;

  historyPanel.innerHTML = `
    <h2>🕘 Chat History</h2>
    <p class="muted">
      आपकी सेव की गई बातचीत इसी ब्राउज़र में रखी जाती है।
