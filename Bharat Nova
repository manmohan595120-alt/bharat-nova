    .addEventListener("click", () => {
      if (!("speechSynthesis" in window)) {
        if (status) {
          status.textContent =
            "इस ब्राउज़र में आवाज़ सुनाने की सुविधा उपलब्ध नहीं है।";
        }
        return;
      }

      const answers = panel.querySelectorAll(".nova-message.ai");
      const last = answers[answers.length - 1];

      if (!last) {
        if (status) status.textContent = "पहले AI का जवाब प्राप्त करें।";
        return;
      }

      const text = last.querySelector("div:last-child")?.textContent || "";
      if (!text.trim()) return;

      window.speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(text.slice(0, 12000));
      utterance.lang =
        voicePanel.querySelector("#novaVoiceLanguage").value;
      utterance.rate = 1;
      utterance.pitch = 1;

      utterance.onstart = () => {
        if (status) status.textContent = "जवाब पढ़कर सुनाया जा रहा है…";
      };

      utterance.onend = () => {
        if (status) status.textContent = "आवाज़ पूरी हो गई।";
      };

      utterance.onerror = () => {
        if (status) status.textContent = "आवाज़ सुनाने में समस्या हुई।";
      };

      window.speechSynthesis.speak(utterance);
    });

  voicePanel.querySelector("#novaStopSpeech")
    .addEventListener("click", () => {
      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }
      if (status) status.textContent = "आवाज़ रोक दी गई।";
    });
