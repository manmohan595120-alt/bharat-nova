   }

   const result = await response.json();

   if (result && result.authorized === true && result.role === "admin") {
    tools.hidden = false;
    status.textContent = "Admin access verified by server.";
   } else {
    status.textContent = "Access denied. Admin permission required.";
   }
  } catch (error) {
   status.textContent =
    "Admin verification unavailable. Dashboard remains locked.";
  } finally {
   checkButton.disabled = false;
  }
 }

 checkButton.addEventListener("click", verifyAdmin);

 if (refreshButton) {
