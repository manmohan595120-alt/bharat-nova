<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#061429">
<meta name="description" content="Bharat Nova — AI Chat, Smart Search, Voice and Productivity">
<meta name="application-name" content="Bharat Nova">
<title>Bharat Nova — AI & Smart Search</title>
<link rel="manifest" href="./manifest.json">
<style>
:root {
  color-scheme: dark;
  --bg: #061429;
  --panel: #0c203a;
  --panel2: #102945;
  --text: #f4f7ff;
  --muted: #a9bad1;
  --gold: #f4c542;
  --border: #29425f;
  --danger: #ff7373;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, Arial, sans-serif;
  min-height: 100vh;
}
button, input, textarea, select {
  font: inherit;
}
button { cursor: pointer; }
button:focus-visible, input:focus-visible,
textarea:focus-visible, a:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
}
a { color: var(--gold); }
[hidden] { display: none !important; }
#app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.container {
  width: min(1100px, 100%);
  margin: 0 auto;
  padding: 16px;
}
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}
.btn {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 14px;
  background: var(--panel2);
  color: var(--text);
}
.btn-primary {
  background: var(--gold);
  color: #171717;
  border-color: var(--gold);
  font-weight: 700;
}
.muted { color: var(--muted); }
.status { font-size: .9rem; color: var(--muted); }
body.light {
  color-scheme: light;
  --bg: #f3f6fb;
  --panel: #ffffff;
  --panel2: #eaf0f8;
  --text: #15243a;
  --muted: #52647b;
  --border: #d4deea;
}
</style>
</head>
<body>
<div id="app">
  <header id="appHeader"></header>
  <main id="mainContent" class="container">
    <section id="homeSection" class="card">
      <h1>Bharat Nova</h1>
      <p class="muted">Search Smarter. Think Bigger.</p>
      <p>आपका AI और Smart Search प्लेटफॉर्म।</p>
      <p class="status" id="appStatus" role="status">
        Bharat Nova तैयार हो रहा है…
      </p>
    </section>
  </main>
  <footer id="appFooter" class="container muted">
    Bharat Nova · Privacy · Help
  </footer>
</div>
<div id="toast" role="status" aria-live="polite" hidden></div>
<script>
"use strict";
(() => {
  const status = document.getElementById("appStatus");
  if (status) {
    status.textContent =
      "Bharat Nova का आधार तैयार है। अगला स्टेप नीचे जोड़ें।";
  }
})();
</script>
<!-- STEP 2 CODE WILL BE PASTED BELOW THIS LINE -->
<!-- STEP 2: BHARAT NOVA DESIGN & THEME -->
<style>
/* Main Header */
#appHeader {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.nova-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 20px;
  font-weight: 800;
}
.nova-logo {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #f4c542, #ff9f1c);
  color: #061429;
  font-size: 24px;
  font-weight: 900;
  box-shadow: 0 4px 16px #f4c54230;
}
.nova-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.nova-header-actions button {
  min-height: 40px;
}
#mainContent {
  width: min(1100px, 100%);
  margin: 0 auto;
  padding: 22px 16px;
  flex: 1;
}
#homeSection {
  padding: clamp(22px, 5vw, 48px);
  background:
    radial-gradient(ellipse at top right, #173b5d 0, transparent 60%),
    var(--panel);
  overflow: hidden;
}
body.light #homeSection {
  background:
    radial-gradient(ellipse at top right, #dcecff 0, transparent 65%),
    var(--panel);
}
#homeSection h1 {
  margin: 0 0 12px;
  font-size: clamp(32px, 7vw, 56px);
  line-height: 1.12;
  letter-spacing: -1.5px;
}
#homeSection > p {
  line-height: 1.7;
}
.nova-highlight {
  color: var(--gold);
}
.nova-tagline {
  font-size: 18px;
  font-weight: 600;
}
.nova-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 12px;
  margin-bottom: 18px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--muted);
  font-size: 13px;
}
.nova-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #42d392;
}
.nova-theme-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.nova-divider {
  border: 0;
  border-top: 1px solid var(--border);
  margin: 24px 0;
}
#appFooter {
  border-top: 1px solid var(--border);
  font-size: 13px;
  text-align: center;
  padding: 20px 16px;
  line-height: 1.8;
}
.nova-footer-links {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 8px;
}
.nova-footer-links a {
  text-decoration: none;
}
button:disabled {
  opacity: .55;
  cursor: not-allowed;
}
@media (max-width: 480px) {
  #appHeader {
    padding: 10px 12px;
  }
  .nova-brand {
    font-size: 18px;
  }
  .nova-logo {
    width: 38px;
    height: 38px;
  }
  #mainContent {
    padding: 14px 12px;
  }
}
</style>

<script>
(() => {
  "use strict";

  const header = document.getElementById("appHeader");
  const footer = document.getElementById("appFooter");
  const home = document.getElementById("homeSection");

  if (header && !header.dataset.novaStyled) {
    header.dataset.novaStyled = "true";

    const brand = document.createElement("div");
    brand.className = "nova-brand";
    brand.innerHTML =
      '<span class="nova-logo" aria-label="Bharat Nova logo">N</span>' +
      '<span>Bharat <span class="nova-highlight">Nova</span></span>';

    const actions = document.createElement("div");
    actions.className = "nova-header-actions";

    const themeButton = document.createElement("button");
    themeButton.type = "button";
    themeButton.className = "btn nova-theme-button";
    themeButton.id = "novaThemeButton";
    themeButton.setAttribute("aria-label", "Change theme");
    themeButton.textContent = "☀️ Theme";

    themeButton.addEventListener("click", () => {
      const light = document.body.classList.toggle("light");

      try {
        localStorage.setItem(
          "bharatNovaTheme",
          light ? "light" : "dark"
        );
      } catch (_) {}

      themeButton.textContent = light ? "🌙 Theme" : "☀️ Theme";
    });

    try {
      if (localStorage.getItem("bharatNovaTheme") === "light") {
        document.body.classList.add("light");
        themeButton.textContent = "🌙 Theme";
      }
    } catch (_) {}

    actions.appendChild(themeButton);
    header.append(brand, actions);
  }

  if (home && !home.dataset.novaStyled) {
    home.dataset.novaStyled = "true";

    const pill = document.createElement("div");
    pill.className = "nova-pill";
    pill.innerHTML =
      '<span class="nova-dot"></span>' +
      '<span>AI-powered smart workspace</span>';

    home.insertBefore(pill, home.firstChild);

    const title = home.querySelector("h1");
    if (title) {
      title.innerHTML =
        'Search Smarter.<br><span class="nova-highlight">' +
        'Think Bigger.</span>';
    }

    const paragraphs = home.querySelectorAll("p");
    if (paragraphs.length > 0) {
      paragraphs[0].classList.add("nova-tagline");
    }
  }

  if (footer && !footer.dataset.novaStyled) {
    footer.dataset.novaStyled = "true";

    const links = document.createElement("div");
    links.className = "nova-footer-links";
    links.innerHTML =
      '<a href="#privacy">Privacy</a>' +
      '<a href="#help">Help & Support</a>' +
      '<a href="#settings">Settings</a>';

    footer.appendChild(links);
  }
})();
</script>
<!-- END STEP 2 -->
