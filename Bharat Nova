  async function askAI() {
    const question = input.value.trim();

    if (busy) return;

    if (!question) {
      status.textContent = "पहले अपना सवाल लिखें।";
      input.focus();
      return;
    }

    if (question.length > 12000) {
      status.textContent = "सवाल बहुत लंबा है। कृपया छोटा करें।";
      return;
    }

    busy = true;
    sendButton.disabled = true;
    status.textContent = "Bharat Nova AI जवाब तैयार कर रहा है…";

    // यूज़र का सवाल चैट में दिखाएँ।
    const userBubble = document.createElement("div");
    userBubble.className = "nova-message user";

    const userLabel = document.createElement("span");
    userLabel.className = "nova-message-label";
    userLabel.textContent = "आप";

    const userContent = document.createElement("div");
    userContent.textContent = question;

    userBubble.append(userLabel, userContent);
    messages.appendChild(userBubble);

    input.value = "";
    messages.scrollTop = messages.scrollHeight;

    try {
      const response = await fetch(WORKER_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify({
          question: question,
          prompt: question,
          messages: [
            ...conversation,
            { role: "user", content: question }
          ]
        }),
        signal: AbortSignal.timeout(60000),
        cache: "no-store"
      });

      const raw = await response.text();

      if (!response.ok) {
        throw new Error("AI सर्वर ने HTTP " + response.status +
          " जवाब दिया।");
      }

      let data;
      try {
        data = JSON.parse(raw);
      } catch {
        throw new Error("AI सर्वर से सही JSON जवाब नहीं मिला।");
      }

      if (data.success === false || data.error) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : "AI अनुरोध पूरा नहीं हो सका।"
        );
      }

      const answer =
        data.answer ??
        data.response ??
        data.reply ??
        data.text ??
        data.result?.response ??
        data.result?.text ??
        data.result;

      if (typeof answer !== "string" || !answer.trim()) {
        throw new Error(
          "जवाब का फ़ॉर्मैट पहचाना नहीं गया। Worker के response फ़ॉर्मैट की जाँच करें।"
        );
      }

      addAIMessage(answer);

      conversation.push(
        { role: "user", content: question },
        { role: "assistant", content: answer }
      );

      // संदर्भ को सीमित रखें।
      if (conversation.length > 12) {
        conversation.splice(0, conversation.length - 12);
      }

      status.textContent = "जवाब तैयार है।";

    } catch (error) {
      addAIMessage(
        "अभी जवाब नहीं मिल पाया। कृपया दोबारा प्रयास करें।"
      );

      status.textContent =
        error.name === "TimeoutError"
          ? "समय समाप्त हुआ। बाद में फिर प्रयास करें।"
          : "कनेक्शन या Worker response में समस्या है: " +
            error.message;

    } finally {
      busy = false;
      sendButton.disabled = false;
      input.focus();
    }
  }

  // Step 4 के पुराने Send handler को बदलें।
  sendButton.onclick = askAI;

  input.addEventListener("keydown", event => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      askAI();
    }
  });
})();
</script>
