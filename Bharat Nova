 const status = document.getElementById("novaAdminStatus");

 if (!section || !checkButton || !tools || !status) return;

 /*
  * Replace this path with a real protected backend endpoint.
  * The server must verify the authenticated user's identity and role.
  * Never put an admin password or secret in this HTML file.
  */
 const ADMIN_VERIFY_ENDPOINT = "";

 async function verifyAdmin() {
  tools.hidden = true;
  status.textContent = "Checking admin authorization...";
  checkButton.disabled = true;

  try {
   if (!ADMIN_VERIFY_ENDPOINT) {
    status.textContent =
     "Admin backend endpoint configure nahi hai. Dashboard locked hai.";
