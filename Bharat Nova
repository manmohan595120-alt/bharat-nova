  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.nova-chat-tools .btn {
  flex: 0 1 auto;
}
.nova-chat-status {
  margin-top: 10px;
  font-size: 13px;
